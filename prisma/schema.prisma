generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  code      RoleCode @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  phone            String
  passwordHash     String
  roleId           String
  status           UserStatus       @default(ACTIVE)
  avatarUrl        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLoginAt      DateTime?
  receivedContacts Contact[]        @relation("ContactRecipient")
  sentContacts     Contact[]        @relation("ContactSender")
  favorites        Favorite[]
  notifications    Notification[]
  approved         Property[]       @relation("PropertyApprover")
  properties       Property[]       @relation("PropertyOwner")
  reviews          PropertyReview[]
  role             Role             @relation(fields: [roleId], references: [id])
  visitRequests    VisitRequest[]

  @@index([email])
}

model Property {
  id              String           @id @default(uuid())
  reference       String           @unique
  ownerId         String
  title           String
  description     String
  propertyType    PropertyType
  purpose         Purpose
  price           Decimal          @db.Decimal(18, 2)
  currency        String           @default("AOA")
  areaM2          Decimal?         @db.Decimal(12, 2)
  bedrooms        Int?
  bathrooms       Int?
  parkingSpaces   Int?
  province        String
  municipality    String
  district        String?
  neighborhood    String?
  address         String?
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  status          PropertyStatus   @default(DRAFT)
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  contacts        Contact[]
  favorites       Favorite[]
  approvedBy      User?            @relation("PropertyApprover", fields: [approvedById], references: [id])
  owner           User             @relation("PropertyOwner", fields: [ownerId], references: [id])
  images          PropertyImage[]
  reviews         PropertyReview[]
  visits          VisitRequest[]

  @@index([status])
  @@index([purpose])
  @@index([propertyType])
  @@index([province])
  @@index([municipality])
  @@index([price])
  @@index([createdAt])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  imageUrl   String
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Contact {
  id          String        @id @default(uuid())
  propertyId  String
  senderId    String
  recipientId String
  message     String
  status      ContactStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recipient   User          @relation("ContactRecipient", fields: [recipientId], references: [id])
  sender      User          @relation("ContactSender", fields: [senderId], references: [id])

  @@index([propertyId])
  @@index([recipientId])
  @@index([senderId])
}

model VisitRequest {
  id            String      @id @default(uuid())
  propertyId    String
  requesterId   String
  preferredDate DateTime
  preferredTime String
  message       String?
  status        VisitStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requester     User        @relation(fields: [requesterId], references: [id])

  @@index([propertyId])
  @@index([requesterId])
}

model PropertyReview {
  id         String       @id @default(uuid())
  propertyId String
  adminId    String
  action     ReviewAction
  reason     String?
  createdAt  DateTime     @default(now())
  admin      User         @relation(fields: [adminId], references: [id])
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum RoleCode {
  BUYER
  TENANT
  OWNER
  AGENT
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  OFFICE
  STORE
  WAREHOUSE
  BUILDING
  OTHER
}

enum Purpose {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

enum VisitStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}
